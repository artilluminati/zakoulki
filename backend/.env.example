# --- база ---
DATABASE_URL=postgresql+psycopg2://zakoulki:пароль@127.0.0.1:5432/zakoulki
SECRET_KEY=сгенерируй-длинный-случайный-ключ

# --- адреса (важно для писем и ссылки возврата из оплаты) ---
SITE_URL=https://example.ru
API_URL=https://api.example.ru

# --- ключ HTTP Геокодера Яндекса (бесплатный) ---
# https://developer.tech.yandex.ru/ -> "Подключить API" -> "JavaScript API и HTTP Геокодер"
YANDEX_GEOCODER_KEY=

# --- почма (SMTP Яндекса) ---
# MAIL_ENABLED=true — включает отправку писем. Без него письма только логируются.
MAIL_ENABLED=false
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USER=zakoulki@yandex.ru
MAIL_PASSWORD=пароль-приложения
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_FROM_NAME=Закоулки

# --- ЮKassa (донаты) ---
# Инструкция по регистрации и настройке: docs/10-yookassa.md
YOOKASSA_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.ru/donate?paid=1
DONATION_MIN=50
DONATION_MAX=100000
DONATION_BADGE_MIN=100
