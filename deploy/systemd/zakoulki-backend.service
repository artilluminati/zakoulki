[Unit]
Description=Zakoulki backend (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=zakoulki
WorkingDirectory=/opt/zakoulki/backend
EnvironmentFile=/opt/zakoulki/backend/.env
ExecStart=/opt/zakoulki/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
