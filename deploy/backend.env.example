# Продакшн-окружение. Скопируй в .env и заполни значения.
# Бэкенд слушает 127.0.0.1:8000, фронт — 127.0.0.1:3001, nginx проксирует домен.
DATABASE_URL=postgresql+psycopg2://zakoulki:пароль@127.0.0.1:5432/zakoulki
SECRET_KEY=замени-на-длинный-случайный-ключ

SITE_URL=https://example.ru
API_URL=https://example.ru/api

YANDEX_GEOCODER_KEY=

MAIL_ENABLED=true
MAIL_HOST=smtp.yandex.ru
MAIL_PORT=587
MAIL_USER=zakoulki@yandex.ru
MAIL_PASSWORD=пароль-приложения
MAIL_USE_TLS=true
MAIL_FROM_NAME=Закоулки

YOOKASSA_ENABLED=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.ru/donate?paid=1
DONATION_MIN=50
DONATION_MAX=100000
DONATION_BADGE_MIN=100
DONATION_SPONSOR_MIN=1000
